# 基础配置
PROJECT_NAME='Auto Web Test'
VERSION=1.0.0
API_V1_STR=/api/v1

# 数据库配置
DATABASE_URL=sqlite:///./test.db

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT='<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</green> | <level>{level: <8}</level> | <cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>'

# 测试配置
TEST_TIMEOUT=30
RETRY_COUNT=3

# 浏览器配置
BROWSER_TYPE=chrome
HEADLESS=false

# 代理配置
PROXY_URL=


# 飞书机器人推送地址
FEISHU_WEBHOOK_URL=
